# APPWRITE_FUNCTION_API_KEY TIDAK dipakai saat runtime — prefix APPWRITE_ reserved
# dan hanya di-inject Appwrite saat BUILD. Kunci dinamis runtime datang lewat
# header x-appwrite-key, yang sudah dibaca getEnv() di src/main.js.
# Isi APPWRITE_API_KEY di bawah hanya untuk menjalankan Function secara lokal.
APPWRITE_API_KEY=your-appwrite-api-key
APPWRITE_DATABASE_ID=your-database-id
USER_FILES_COLLECTION_ID=user_files
USER_STORAGE_USAGE_COLLECTION_ID=user_storage_usage
# WAJIB `user-files`. Di situlah kuota per-pengguna ditegakkan lewat
# user_storage_usage, dan bucket itu satu-satunya yang fileSecurity=true
# sehingga Permission.read per-berkas yang dipasang Function benar-benar berlaku.
# JANGAN arahkan ke campaign-assets: bucket itu read("any") + fileSecurity=false,
# jadi setiap berkas terbaca publik dan izin per-berkas diabaikan server.
# Insiden 2026-07-29 — lihat integration-context/2026-07-29-audit-live-*.md §3.
DEFAULT_STORAGE_BUCKET_ID=user-files

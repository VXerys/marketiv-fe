# Runtime environment contract. Values intentionally empty.

# ============================================================
# Appwrite-injected environment
# ============================================================

# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_API_ENDPOINT=
# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_ENDPOINT=
# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_PROJECT_ID=
# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_USER_ID=

# ============================================================
# Legacy Appwrite compatibility
# ============================================================

# Legacy fallback for dynamic x-appwrite-key request header
APPWRITE_API_KEY=
# Legacy database key - no Appwrite-injected database ID
APPWRITE_DATABASE_ID=
# Legacy fallback for APPWRITE_FUNCTION_API_ENDPOINT
APPWRITE_ENDPOINT=
# Legacy fallback for APPWRITE_FUNCTION_PROJECT_ID
APPWRITE_PROJECT_ID=

# ============================================================
# Appwrite resource identifiers
# ============================================================

CAMPAIGN_BRIEFS_COLLECTION_ID=


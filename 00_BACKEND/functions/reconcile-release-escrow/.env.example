# ============================================================
# Shared / Appwrite environment
# ============================================================

# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_API_ENDPOINT=
# Required unless APPWRITE_FUNCTION_API_ENDPOINT is set
APPWRITE_ENDPOINT=
# Appwrite injected automatically - DO NOT configure manually
APPWRITE_FUNCTION_PROJECT_ID=
# Required unless APPWRITE_FUNCTION_PROJECT_ID is set
APPWRITE_PROJECT_ID=
# Optional - runtime can use x-appwrite-key request header
APPWRITE_API_KEY=
# Required unless NEXT_PUBLIC_DB_ID is set
APPWRITE_DATABASE_ID=
# Optional - fallback for APPWRITE_DATABASE_ID
NEXT_PUBLIC_DB_ID=

# ============================================================
# Function-specific environment
# ============================================================

# Optional - runtime has a default value
ESCROWS_COLLECTION_ID=
ORDERS_COLLECTION_ID=
TRANSACTIONS_COLLECTION_ID=

# Disuntikkan otomatis oleh Appwrite runtime
APPWRITE_FUNCTION_API_ENDPOINT=
APPWRITE_FUNCTION_PROJECT_ID=

# Wajib diisi manual di Function settings.
# API key HARUS punya scope `users.read` — ownerName diambil dari akun Auth.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Opsional — default sudah sesuai appwrite.config.json
USERS_COLLECTION_ID=users
UMKM_PROFILES_COLLECTION_ID=umkm_profiles

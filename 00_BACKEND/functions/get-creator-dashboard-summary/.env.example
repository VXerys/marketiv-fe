# Disuntikkan otomatis oleh Appwrite runtime
APPWRITE_FUNCTION_API_ENDPOINT=
APPWRITE_FUNCTION_PROJECT_ID=

# Wajib diisi manual di Function settings
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Opsional — default sudah sesuai appwrite.config.json
CAMPAIGNS_COLLECTION_ID=campaigns
CLAIMS_COLLECTION_ID=campaign_claims
SUBMISSIONS_COLLECTION_ID=campaign_submissions
ORDERS_COLLECTION_ID=orders
ESCROWS_COLLECTION_ID=escrows
WALLETS_COLLECTION_ID=wallets
TRANSACTIONS_COLLECTION_ID=transactions
RATE_CARDS_COLLECTION_ID=rate_cards

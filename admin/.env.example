# ---------------------------------------------------------------------------
# Marketiv Admin Application — Environment Variables
# ---------------------------------------------------------------------------

# Environment Mode (staging / production)
NEXT_PUBLIC_APP_ENV=staging

# ---------------------------------------------------------------------------
# Appwrite Backend Configuration (Shared with User Application)
# ---------------------------------------------------------------------------
# Required. Set each value explicitly for target environment.
# This example is documentation only; Admin does not fall back to staging.
# Staging Admin Site:
# NEXT_PUBLIC_APPWRITE_ENDPOINT=https://api-admin-staging.marketiv.id/v1
# Keep project/database IDs equal to the user staging Site. The separate API
# hostname isolates browser sessions without creating another Appwrite project.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# ---------------------------------------------------------------------------
# Cross-App Navigation Origin
# ---------------------------------------------------------------------------
# Required. Staging example: https://staging.marketiv.id
# Production example: https://marketiv.id
NEXT_PUBLIC_USER_APP_URL=

# Campaign view observation delay. Staging may set 0; production default is 72.
NEXT_PUBLIC_VIEW_VALIDATION_DELAY_HOURS=72

# ---------------------------------------------------------------------------
# Security Boundary
# ---------------------------------------------------------------------------
# NEVER include server API keys (APPWRITE_API_KEY, MIDTRANS_SERVER_KEY)
# or webhook secrets in this browser-safe configuration file.

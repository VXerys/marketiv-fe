# ---------------------------------------------------------------------------
# Marketiv Admin Application — Environment Variables
# ---------------------------------------------------------------------------

# Environment Mode (staging / production)
NEXT_PUBLIC_APP_ENV=staging

# ---------------------------------------------------------------------------
# Appwrite Backend Configuration (Shared with User Application)
# ---------------------------------------------------------------------------
# Staging:
#   NEXT_PUBLIC_APPWRITE_ENDPOINT=https://api.marketiv.id/v1
#   NEXT_PUBLIC_APPWRITE_PROJECT_ID=69f9d45b00315cb0ec2f
#   NEXT_PUBLIC_APPWRITE_DATABASE_ID=6a4c8598001da3b0d7f0
# Production:
#   NEXT_PUBLIC_APPWRITE_ENDPOINT=https://api.marketiv.id/v1
#   NEXT_PUBLIC_APPWRITE_PROJECT_ID=<production-project-id>
#   NEXT_PUBLIC_APPWRITE_DATABASE_ID=<production-database-id>
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://api.marketiv.id/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=69f9d45b00315cb0ec2f
NEXT_PUBLIC_APPWRITE_DATABASE_ID=6a4c8598001da3b0d7f0

# ---------------------------------------------------------------------------
# Cross-App Navigation Origin
# ---------------------------------------------------------------------------
# Staging:    https://staging.marketiv.id
# Production: https://marketiv.id
NEXT_PUBLIC_USER_APP_URL=https://staging.marketiv.id

# ---------------------------------------------------------------------------
# Security Boundary
# ---------------------------------------------------------------------------
# NEVER include server API keys (APPWRITE_API_KEY, MIDTRANS_SERVER_KEY)
# or webhook secrets in this browser-safe configuration file.

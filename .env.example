# OpenRouter API Configuration (BACKUP/FALLBACK - when Vertex AI fails or for quick local testing)
# Sign up at https://openrouter.ai/ (Google/GitHub login)
# Get your free API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-35b-a3b

# Vertex AI Configuration (PRIMARY PROVIDER - GCP Free Credit $300)
# Instructions:
# 1. Create a Google Cloud Project and enable the Vertex AI API
# 2. Create a Service Account with 'Vertex AI User' role
# 3. Generate a JSON Key for the service account and copy the fields below:
# ===OR===
# Ask your partner for the key
VERTEX_AI_PROJECT_ID=your_gcp_project_id_here
VERTEX_AI_CLIENT_EMAIL=your_service_account_email@your_project_id.iam.gserviceaccount.com
VERTEX_AI_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

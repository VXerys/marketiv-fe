# ---------------------------------------------------------------------------
# Data Source Switch
# Dibaca oleh src/config/data-source.config.ts
#   true      → seluruh dashboard memakai mock di src/mocks/** (default dev)
#   false     → memanggil Appwrite lewat *-appwrite.service.ts
#   undefined → dianggap true (mock ON) supaya clone baru langsung jalan
# Default staging akan diubah ke false pada task s5-mock-off.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=false

# Role identitas sintetis saat mock ON. Dibaca src/services/auth/session.service.ts.
# Sejak s6-guard-redirect, RoleGuard tidak lagi di-bypass di mode mock — jadi
# dashboard yang terbuka mengikuti role ini. Login lewat /login menimpanya
# (disimpan di localStorage) dan logout membersihkannya.
#   umkm | creator | admin — nilai lain diabaikan, fallback "umkm".
NEXT_PUBLIC_MOCK_ROLE=umkm

# ---------------------------------------------------------------------------
# Autentikasi — dibaca src/config/auth.config.ts
# Google OAuth default MATI: provider-nya belum dikonfigurasi di konsol Appwrite
# (handoff-auth-sprint6.md §A-3). Selama false, tombol "Login dengan Google"
# tidak dirender sama sekali, bukan dirender lalu error.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false

# ---------------------------------------------------------------------------
# Appwrite — Public (Browser-Safe) Variables
# Aman diekspos ke browser lewat prefix NEXT_PUBLIC_.
# Nilai nyata ada di 00_BACKEND/appwrite.config.json.
# JANGAN menambahkan API key atau kredensial server di sini.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=

# Bucket per kegunaan (project punya 7 bucket, bukan satu).
# Kosongkan untuk memakai default di src/lib/appwrite/config.ts.
NEXT_PUBLIC_APPWRITE_STORAGE_BUCKET_ID=
NEXT_PUBLIC_APPWRITE_BUCKET_AVATARS=
NEXT_PUBLIC_APPWRITE_BUCKET_LOGOS=
NEXT_PUBLIC_APPWRITE_BUCKET_PORTFOLIOS=
NEXT_PUBLIC_APPWRITE_BUCKET_CAMPAIGN_ASSETS=
NEXT_PUBLIC_APPWRITE_BUCKET_DELIVERABLES=
NEXT_PUBLIC_APPWRITE_BUCKET_FRAUD_EVIDENCE=

# ---------------------------------------------------------------------------
# Appwrite — Server-Only Variables (NEVER expose to browser)
# Used only in Appwrite Functions or secure Server Actions.
# ---------------------------------------------------------------------------
# APPWRITE_API_KEY=           # Server SDK elevated key — server only

# ---------------------------------------------------------------------------
# OpenRouter API Configuration (FREE - no credit card needed)
# Sign up at https://openrouter.ai/ (Google/GitHub login)
# Get your free API key at https://openrouter.ai/settings/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-35b-a3b

# ---------------------------------------------------------------------------
# Midtrans Snap (pembayaran escrow campaign — s3-wizard-real 6b)
# Client key aman di browser; SERVER KEY hanya di Function create-payment
# (MIDTRANS_SERVER_KEY), jangan pernah ditaruh di NEXT_PUBLIC_*.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
NEXT_PUBLIC_MIDTRANS_ENV=sandbox
